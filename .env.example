# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает.

# Основной вариант: Claude через Anthropic API (на нём сделаны отчёты в репозитории).
# Ключ: https://platform.claude.com/settings/keys (нужен баланс, около $2 за документ на Opus, $1 на Sonnet)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Дешевле и быстрее, чуть меньше находок: LLM_MODEL=claude-sonnet-5-5

# Бесплатный вариант: Gemini API (Google AI Studio), ключ: https://aistudio.google.com/apikey
# Закомментируйте три строки выше и раскомментируйте эти:
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash

# Другие OpenAI-совместимые провайдеры (LLM_PROVIDER=openai_compat):
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1/        LLM_MODEL=gpt-4.1-mini
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1/     LLM_MODEL=<модель>
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1/        LLM_MODEL=qwen2.5:7b   (ключ не нужен)
