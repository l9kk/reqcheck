# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает.

# Claude через Anthropic API. Отчёты в репозитории сделаны на той же модели, но не через
# API-ключ, а через подписку Claude Code и локальный прокси tools/claude_proxy.py (см. README).
# Ключ: https://platform.claude.com/settings/keys
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# Модель внутри контура банка с OpenAI-совместимым API: замените три строки выше на
# LLM_PROVIDER=openai_compat, LLM_BASE_URL=<адрес>, LLM_API_KEY=<ключ>, LLM_MODEL=<модель>.
